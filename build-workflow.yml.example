name: Build and Release Android APK

on:
  push:
    tags:
      - 'v*'

jobs:
  build:
    name: Build & Release Signed APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
          cache: 'gradle'

      - name: Decode Android Keystore
        working-directory: android-app
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        run: |
          if [ -n "$KEYSTORE_BASE64" ]; then
            echo "$KEYSTORE_BASE64" | base64 --decode > app/keystore.jks
            echo "Keystore successfully decoded into android-app/app/keystore.jks"
          else
            echo "WARNING: KEYSTORE_BASE64 secret not found. Falling back to unsigned/debug."
          fi

      - name: Make Gradle Wrapper Executable
        working-directory: android-app
        run: chmod +x gradlew || true

      - name: Build Release APK
        working-directory: android-app
        env:
          KEYSTORE_FILE: keystore.jks
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -f "app/keystore.jks" ]; then
            ./gradlew assembleRelease --stacktrace
          else
            ./gradlew assembleDebug --stacktrace
            mkdir -p app/build/outputs/apk/release/
            cp app/build/outputs/apk/debug/*.apk app/build/outputs/apk/release/Music-app-release.apk
          fi

      - name: Rename APK for Release
        working-directory: android-app
        run: |
          APK_PATH=$(find app/build/outputs/apk -name "*.apk" | head -n 1)
          cp "$APK_PATH" Music-app-${{ github.ref_name }}.apk
          echo "Release APK ready at android-app/Music-app-${{ github.ref_name }}.apk"

      - name: Create GitHub Release and Upload APK
        uses: softprops/action-gh-release@v2
        with:
          files: android-app/Music-app-${{ github.ref_name }}.apk
          name: Release ${{ github.ref_name }}
          body: |
            Automated release build for **Music-app** tag `${{ github.ref_name }}`.
            
            ### Included:
            - Latest NewPipe Extractor parsing fixes
            - Media3 ExoPlayer streaming updates
            - Offline downloads support
            - Render backend sync
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
