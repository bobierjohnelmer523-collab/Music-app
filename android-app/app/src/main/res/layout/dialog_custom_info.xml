<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_spotify_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/info_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/spotify_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="Song Credits" />

    <LinearLayout
        android:id="@+id/info_dialog_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="#1B1B1B"
        android:padding="16dp">

        <TextView
            android:id="@+id/info_dialog_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/spotify_light_grey"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <TextView
            android:id="@+id/btn_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Close"
            android:textColor="@color/spotify_black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
