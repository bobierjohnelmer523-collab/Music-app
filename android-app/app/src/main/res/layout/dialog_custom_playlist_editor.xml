<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_spotify_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_editor_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Playlist"
        android:textColor="@color/spotify_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Cover Preview + Choose Media -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/spotify_card_grey">

            <ImageView
                android:id="@+id/img_editor_cover_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_library"
                app:tint="@color/spotify_green" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playlist Cover (GIF or Image)"
                android:textColor="@color/spotify_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_pick_cover_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_button_cancel"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Choose from Gallery"
                android:textColor="@color/spotify_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cover Image/GIF URL Input (optional alternative to picking) -->
    <EditText
        android:id="@+id/edit_playlist_cover_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="#1E1E1E"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:hint="or paste GIF / Image URL"
        android:textColor="@color/spotify_white"
        android:textColorHint="@color/spotify_light_grey"
        android:textSize="13sp"
        android:inputType="textUri"
        android:maxLines="1" />

    <!-- Title Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Title *"
        android:textColor="@color/spotify_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_playlist_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="#1E1E1E"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:hint="My Playlist"
        android:textColor="@color/spotify_white"
        android:textColorHint="@color/spotify_light_grey"
        android:textSize="14sp"
        android:inputType="textCapSentences"
        android:maxLines="1" />

    <!-- Description Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Description (Optional)"
        android:textColor="@color/spotify_light_grey"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edit_playlist_description"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="#1E1E1E"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:hint="Add an optional description"
        android:textColor="@color/spotify_white"
        android:textColorHint="@color/spotify_light_grey"
        android:textSize="13sp"
        android:inputType="textCapSentences"
        android:maxLines="2" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel_playlist_editor"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_button_cancel"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Cancel"
            android:textColor="@color/spotify_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_save_playlist_editor"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Save"
            android:textColor="@color/spotify_black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
