<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Full-width image backdrop behind the playlist header. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_playlist_background"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:alpha="0.82"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:id="@+id/view_playlist_background_gradient"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/gradient_spotify" />

            <LinearLayout
                android:id="@+id/layout_playlist_header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Top Navigation Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btn_back_playlist_detail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/spotify_white"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btn_playlist_options"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Playlist options"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/spotify_white" />

                </RelativeLayout>

                <!-- Large cover, with the backdrop continuing under the title and stats. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="4dp">

            <androidx.cardview.widget.CardView
                android:layout_width="232dp"
                android:layout_height="232dp"
                android:layout_gravity="center"
                app:cardCornerRadius="10dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/spotify_card_grey">

                <ImageView
                    android:id="@+id/img_playlist_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_library"
                    app:tint="@color/spotify_green" />
            </androidx.cardview.widget.CardView>

                </FrameLayout>

        <!-- Playlist Title -->
                <TextView
            android:id="@+id/text_playlist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/spotify_white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Dap" />

        <!-- Description (Optional) -->
                <TextView
            android:id="@+id/text_playlist_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/spotify_light_grey"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Chill and relaxing beats for late night vibes." />

        <!-- Creator & Song stats -->
                <TextView
            android:id="@+id/text_playlist_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/spotify_light_grey"
            android:textSize="13sp"
            tools:text="Playlist • 12 songs • 38 min" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

        <!-- Controls Action Bar (Play, Shuffle, Download) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_playlist_download_all"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download"
                app:tint="@color/spotify_light_grey"
                android:contentDescription="Download all offline" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_playlist_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/spotify_light_grey"
                android:contentDescription="Shuffle playlist" />

            <!-- Big Green Spotify Play Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_playlist_play_fab"
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/spotify_green">

                <ImageView
                    android:id="@+id/img_play_fab_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    app:tint="@color/spotify_black" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_add_playlist_tracks"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_button_cancel"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="＋  Add"
                    android:textColor="@color/spotify_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_edit_playlist"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_button_cancel"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:drawableStart="@drawable/ic_edit_playlist"
                    android:drawablePadding="6dp"
                    android:text="Edit"
                    android:textColor="@color/spotify_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_sort_playlist"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_button_cancel"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="⇅  Sort"
                    android:textColor="@color/spotify_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#1E1E1E" />

        <!-- Tracks List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_playlist_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_playlist_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_music_note"
                app:tint="@color/spotify_light_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="This playlist is empty"
                android:textColor="@color/spotify_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Find more songs to add to this playlist"
                android:textColor="@color/spotify_light_grey"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_find_songs_to_add"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_button"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Search Songs"
                android:textColor="@color/spotify_black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_playlist_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/spotify_green"
            android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
