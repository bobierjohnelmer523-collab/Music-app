<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="?selectableItemBackground">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_playlist_grid_cover"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/spotify_card_grey">

        <ImageView
            android:id="@+id/img_playlist_grid_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_library"
            app:tint="@color/spotify_green" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_playlist_grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/spotify_white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Playlist Title" />

    <TextView
        android:id="@+id/text_playlist_grid_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/spotify_light_grey"
        android:textSize="12sp"
        tools:text="Playlist • Jel." />

</LinearLayout>
