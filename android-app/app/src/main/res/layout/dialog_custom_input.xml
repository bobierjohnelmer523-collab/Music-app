<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_spotify_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/input_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/spotify_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="New Offline List" />

    <TextView
        android:id="@+id/input_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/spotify_light_grey"
        android:textSize="13sp"
        android:text="Enter a name to organize your offline songs into folders." />

    <EditText
        android:id="@+id/edit_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_connection_banner"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/spotify_white"
        android:textColorHint="@color/spotify_light_grey"
        android:textSize="15sp"
        android:hint="Folder Name"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_input_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_button_cancel"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Cancel"
            android:textColor="@color/spotify_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_input_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Create"
            android:textColor="@color/spotify_black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
