<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#737373"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <ImageButton
        android:id="@+id/btn_close_fullscreen_lyrics"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Close lyrics"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/spotify_white" />

    <LinearLayout
        android:id="@+id/layout_fullscreen_lyrics_track"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btn_close_fullscreen_lyrics"
        app:layout_constraintEnd_toStartOf="@id/btn_more_fullscreen_lyrics"
        app:layout_constraintStart_toEndOf="@id/btn_close_fullscreen_lyrics"
        app:layout_constraintTop_toTopOf="@id/btn_close_fullscreen_lyrics">

        <TextView
            android:id="@+id/text_fullscreen_lyrics_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/spotify_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_fullscreen_lyrics_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#EFEFEF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_more_fullscreen_lyrics"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Track options"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/spotify_white" />

    <ScrollView
        android:id="@+id/scroll_fullscreen_lyrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingTop="38dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_fullscreen_lyrics_play_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_close_fullscreen_lyrics">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/text_fullscreen_lyrics_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Loading synced lyrics…"
            android:textColor="#111111"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/layout_fullscreen_lyrics_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_fullscreen_lyrics_play_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/spotify_white"
        android:contentDescription="Play or pause"
        android:src="@drawable/ic_play"
        app:fabCustomSize="72dp"
        app:maxImageSize="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#000000" />

</androidx.constraintlayout.widget.ConstraintLayout>
