<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:padding="24dp">

    <!-- Top bar: Collapse, Header, 3 dots share menu -->
    <ImageView
        android:id="@+id/btn_collapse"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_skip_previous"
        android:rotation="-90"
        app:tint="@color/spotify_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_now_playing_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAYING FROM YOUTUBE MUSIC"
        android:textColor="@color/spotify_light_grey"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="@id/btn_collapse"
        app:layout_constraintBottom_toBottomOf="@id/btn_collapse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_more_menu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/spotify_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Share &amp; More" />

    <!-- Album Art / Thumbnail -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/spotify_card_grey"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/btn_collapse"
        app:layout_constraintBottom_toTopOf="@id/text_song_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_now_playing_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </androidx.cardview.widget.CardView>

    <!-- Track Title & Artist -->
    <TextView
        android:id="@+id/text_song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:textColor="@color/spotify_white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/text_song_artist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_track_actions"
        tools:text="Need You" />

    <TextView
        android:id="@+id/text_song_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/spotify_light_grey"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/seekbar_playback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layout_track_actions"
        tools:text="Bosx1ne" />

    <!-- Plus button (Add to playlist) & X button (Blacklist) -->
    <LinearLayout
        android:id="@+id/layout_track_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_song_title"
        app:layout_constraintBottom_toBottomOf="@id/text_song_artist">

        <ImageButton
            android:id="@+id/btn_add_to_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            app:tint="@color/spotify_white"
            android:contentDescription="Add to Playlist" />

        <ImageButton
            android:id="@+id/btn_blacklist_track"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/spotify_light_grey"
            android:contentDescription="Don't play this song (Blacklist)" />
    </LinearLayout>

    <!-- Seekbar & Timestamps -->
    <SeekBar
        android:id="@+id/seekbar_playback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:progressTint="@color/spotify_white"
        android:thumbTint="@color/spotify_white"
        app:layout_constraintBottom_toTopOf="@id/text_current_time" />

    <TextView
        android:id="@+id/text_current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="0:00"
        android:textColor="@color/spotify_light_grey"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/seekbar_playback"
        app:layout_constraintBottom_toTopOf="@id/layout_controls" />

    <TextView
        android:id="@+id/text_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="0:00"
        android:textColor="@color/spotify_light_grey"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/seekbar_playback"
        app:layout_constraintBottom_toTopOf="@id/layout_controls" />

    <!-- Playback Controls: Shuffle on left, Prev, Play/Pause, Next, Download on right -->
    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Shuffle / Mode button -->
        <ImageButton
            android:id="@+id/btn_shuffle_mode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/spotify_white"
            android:contentDescription="Shuffle &amp; Repeat Settings" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/spotify_white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/spotify_white"
            android:src="@drawable/ic_play"
            app:tint="@color/spotify_black"
            app:fabCustomSize="64dp" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/spotify_white" />

        <!-- Download button / progress next to next button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_download_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download"
                app:tint="@color/spotify_white"
                android:contentDescription="Download for Offline Playback" />

            <FrameLayout
                android:id="@+id/layout_download_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progress_circle_download"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressDrawable="@drawable/circle_progress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:max="100" />

                <TextView
                    android:id="@+id/text_download_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="9sp"
                    android:textColor="@color/spotify_green"
                    android:textStyle="bold"
                    android:text="0%" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
