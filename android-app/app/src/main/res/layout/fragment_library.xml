<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/spotify_black"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <!-- Top Bar: Avatar + "Your Library" + Search + Plus -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_profile_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/spotify_amber">

            <TextView
                android:id="@+id/text_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="J"
                android:textColor="@color/spotify_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_avatar_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                android:visibility="gone"
                app:tint="@color/spotify_black" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_profile_avatar"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:text="Your Library"
            android:textColor="@color/spotify_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_library_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                app:tint="@color/spotify_white"
                android:contentDescription="Search Library" />

            <ImageButton
                android:id="@+id/btn_create_playlist"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@color/spotify_white"
                android:contentDescription="New Playlist" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Filter Chips Row (Playlists, Podcasts, Artists, Downloaded) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_playlists"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/chip_selected_bg"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Playlists"
                android:textColor="@color/spotify_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_podcasts"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Podcasts"
                android:textColor="@color/spotify_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_artists"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Artists"
                android:textColor="@color/spotify_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_downloaded"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Downloaded"
                android:textColor="@color/spotify_white"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sort & Layout Switcher Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/layout_sort_recents"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?selectableItemBackground"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_sort"
                app:tint="@color/spotify_white" />

            <TextView
                android:id="@+id/text_sort_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Recents"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_toggle_view_mode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_grid_view"
            app:tint="@color/spotify_white"
            android:contentDescription="Switch between List and Grid view" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progress_library"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/spotify_green"
        android:visibility="gone" />

    <!-- Unified RecyclerView (Hosts Liked Songs, Downloaded Songs, and Custom Playlists) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_playlists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/text_empty_library"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:textColor="@color/spotify_light_grey"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="Create a playlist to see it here" />

</LinearLayout>
