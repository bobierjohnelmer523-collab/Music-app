<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black">

    <!-- Fatal / Source Broken Banner -->
    <LinearLayout
        android:id="@+id/banner_source_broken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/spotify_amber"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/spotify_black" />

        <TextView
            android:id="@+id/text_banner_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/spotify_black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/source_broken_warning" />

        <Button
            android:id="@+id/btn_banner_update"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/spotify_black"
            android:textStyle="bold"
            android:text="Update" />
    </LinearLayout>

    <!-- Connection Status Pill / WiFi-style Indicator (Neon + Render) -->
    <LinearLayout
        android:id="@+id/layout_connection_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_connection_banner"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="8dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/banner_source_broken"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progress_connection_status"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminateTint="@color/spotify_green"
            android:indeterminate="true"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/icon_connection_status"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_wifi_status"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            app:tint="@color/spotify_green" />

        <TextView
            android:id="@+id/text_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/spotify_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="Connecting" />

        <ImageView
            android:id="@+id/btn_close_connection_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:src="@drawable/ic_close"
            app:tint="@color/spotify_light_grey" />
    </LinearLayout>

    <!-- Main Content Container for Fragments -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/banner_source_broken"
        app:layout_constraintBottom_toTopOf="@id/mini_player_container" />

    <!-- Mini Player Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mini_player_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/mini_player_bg"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/mini_player_thumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/mini_player_thumbnail"
                app:layout_constraintEnd_toStartOf="@id/mini_player_play_pause"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/mini_player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/spotify_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Song Title" />

                <TextView
                    android:id="@+id/mini_player_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/spotify_light_grey"
                    android:textSize="12sp"
                    tools:text="Artist Name" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mini_player_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                app:tint="@color/spotify_white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ProgressBar
                android:id="@+id/mini_player_progress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:progressTint="@color/spotify_white"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/spotify_black"
        app:itemIconTint="@drawable/nav_item_color"
        app:itemTextColor="@drawable/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
