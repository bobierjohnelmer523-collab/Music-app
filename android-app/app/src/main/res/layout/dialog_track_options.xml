<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/spotify_dark_grey"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="32dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Track Header Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/spotify_card_grey">

            <ImageView
                android:id="@+id/img_sheet_track_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_sheet_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/spotify_white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/text_sheet_track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/spotify_light_grey"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Artist Name" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E"
        android:layout_marginBottom="12dp" />

    <!-- Option 1: Add to Liked / Favorite -->
    <LinearLayout
        android:id="@+id/layout_option_like"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:id="@+id/icon_option_like"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/spotify_white" />

        <TextView
            android:id="@+id/text_option_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Add to Liked Songs"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 2: Add to Playlist -->
    <LinearLayout
        android:id="@+id/layout_option_add_playlist"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_add"
            app:tint="@color/spotify_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Add to playlist"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 3: Add to Queue -->
    <LinearLayout
        android:id="@+id/layout_option_add_queue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_queue"
            app:tint="@color/spotify_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Add to queue"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 4: Download for Offline -->
    <LinearLayout
        android:id="@+id/layout_option_download"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:id="@+id/icon_option_download"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_download"
            app:tint="@color/spotify_white" />

        <TextView
            android:id="@+id/text_option_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Download"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 5: Share -->
    <LinearLayout
        android:id="@+id/layout_option_share"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_share"
            app:tint="@color/spotify_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Share"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 6: Song Credits -->
    <LinearLayout
        android:id="@+id/layout_option_credits"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_info"
            app:tint="@color/spotify_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Song credits"
            android:textColor="@color/spotify_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
